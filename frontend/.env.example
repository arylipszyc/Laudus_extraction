# URL of the backend API (Cloud Run URL in production)
VITE_API_URL=http://localhost:8000

# Origin del servicio Fava (basic-auth, contador-only). Habilita el deep-link "ver asiento
# completo en Fava" desde el drill-down del reporte. Si no está set, el affordance no aparece.
# Prod: la URL del web service `laudus-fava` en Render (ej. https://laudus-fava.onrender.com)
VITE_FAVA_URL=
