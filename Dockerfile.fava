# Story 9.3 — Fava UI en Render detrás de basic auth (nginx) leyendo el ledger Beancount.
#
# nginx (en $PORT) → basic auth (htpasswd generado al boot desde env) → proxy a Fava (127.0.0.1:5000).
# El ledger se clona/pullea a /ledger (persistent disk) con refresh cada 60s. El editor de Fava
# usa el wrapper bean-check de Story 9.0 (extension declarada en main.beancount).
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git openssh-client nginx apache2-utils gettext-base \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "fava>=1.27" "beancount>=3.0" "watchfiles>=0.21"

WORKDIR /app
COPY entrypoint-fava.sh /app/entrypoint-fava.sh
COPY nginx-fava.conf /app/nginx-fava.conf
RUN chmod +x /app/entrypoint-fava.sh

# Render inyecta $PORT; nginx escucha ahí. Fava queda en localhost:5000 (no expuesto).
ENV FAVA_PORT=5000
ENTRYPOINT ["/app/entrypoint-fava.sh"]
