;; ---------------------------------------------------------------------------
;; WASH apertura/cierre — [SINTÉTICO] par igual-y-opuesto que netea a 0,
;; modelado en el caso canónico Latinoamericana ±423,6M (E1.3 debe lavarlo). El
;; asiento real de cierre del mirror tiene 184 patas (cierre anual completo); acá
;; se reduce al par mínimo Latinoamericana↔Apertura para mantener el slice chico
;; conservando la señal que E1.3 detecta: glosa "Comprobante de apertura/cierre".
;; [Source: ledger/imports/laudus-rut2/2021-12.beancount JE 4515 (id 4529) —
;;  Income:FFCC:LatinoamericanaSa-310009 +423.600.000 en el cierre]
;; ---------------------------------------------------------------------------
2021-12-31 * "Comprobante de cierre"
  id: "9000001"
  source: "laudus-erp"
  entity: "RUT2"
  nature: "wash"
  Income:FFCC:LatinoamericanaSa-310009  423600000.00 CLP
    desc: "Comprobante de cierre"
  Liabilities:FFCC:Apertura-211005  -423600000.00 CLP
    desc: "Comprobante de cierre"

2022-01-01 * "Comprobante de apertura"
  id: "9000002"
  source: "laudus-erp"
  entity: "RUT2"
  nature: "wash"
  Income:FFCC:LatinoamericanaSa-310009  -423600000.00 CLP
    desc: "Comprobante de apertura"
  Liabilities:FFCC:Apertura-211005  423600000.00 CLP
    desc: "Comprobante de apertura"

;; ---------------------------------------------------------------------------
;; USD multi-moneda — [SINTÉTICO]. El mirror no tiene NINGÚN posting en USD
;; (todo CLP; el "USD" real vive como texto en `desc`). Se fuerza ≥1 asiento con
;; `units.currency == "USD"` + precio, para que E1.5 lo cargue con
;; `amount_currency`/`currency_id`. 100 USD @ 800 CLP = 80.000 CLP.
;; ---------------------------------------------------------------------------
2021-02-10 * "JE 9000003" "Compra USD sintética (fuerza amount_currency para E1.5)"
  id: "9000003"
  source: "laudus-erp"
  entity: "EAG"
  nature: "usd"
  Assets:EAG:CajaUs-111003  100.00 USD @ 800.00 CLP
    desc: "USD100 caso sintético multi-moneda"
  Assets:EAG:Bancos:BancoBci10160175-111005  -80000.00 CLP
    desc: "USD100 caso sintético multi-moneda"
