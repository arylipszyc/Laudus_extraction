# ── Frontend ──────────────────────────────────────────────────────────────────
# URL of the deployed frontend (used for CORS allow-list)
FRONTEND_URL=http://localhost:5173

# ── Auth (HTTP Basic — reemplaza Google OAuth) ────────────────────────────────
# Credencial única compartida que protege la API. Sin roles.
APP_BASIC_AUTH_USER=admin
APP_BASIC_AUTH_PASSWORD=change-me

# ── Sync incremental — ventana solapada (Story 2.4) ───────────────────────────
# Meses que el importer Laudus re-pide hacia atrás en CADA corrida, además del
# watermark del último import. Cubre el año fiscal en curso + margen para
# backdating de cierre del año anterior.
SYNC_OVERLAP_WINDOW_MONTHS=13

# ── Laudus ERP (pipeline de sync — la única fuente del espejo) ────────────────
LAUDUS_USERNAME=your-laudus-username
LAUDUS_PASSWORD=your-laudus-password
LAUDUS_COMPANYVATID=your-company-vat-id
# Libro RUT2 / Fondo Común JAB-FGK — companyVATId del segundo libro
LAUDUS_COMPANYVATID_RUT2=your-rut2-company-vat-id

# ── Beancount engine ──────────────────────────────────────────────────────────
# Entry point del ledger (espejo de Laudus). El backend lo carga en memoria + file watcher.
LEDGER_PATH=ledger/main.beancount
